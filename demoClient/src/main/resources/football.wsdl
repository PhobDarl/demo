<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:sch="https://www.phobdarl.com/xml/football" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="https://www.phobdarl.com/xml/football" targetNamespace="https://www.phobdarl.com/xml/football">
  <wsdl:types>
    <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="https://www.phobdarl.com/xml/football">
    <!-- Request that comes from the client, putting in scores -->
    <xs:element name="enterScoresRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="homeTeam" type="xs:string"/>
                <xs:element name="awayTeam" type="xs:string"/>
                <xs:element name="homeGoals" type="xs:int"/>
                <xs:element name="awayGoals" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Response sent to the client -->
    <xs:element name="enterScoresResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="done" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="teamXSD">
        <xs:sequence>
            <xs:element name="id" type="xs:long"/>
            <xs:element name="name" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="getTeamsRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="howMany" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getTeamsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element maxOccurs="unbounded" minOccurs="0" name="teams" type="tns:teamXSD"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
  </wsdl:types>
  <wsdl:message name="enterScoresRequest">
    <wsdl:part element="tns:enterScoresRequest" name="enterScoresRequest">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="enterScoresResponse">
    <wsdl:part element="tns:enterScoresResponse" name="enterScoresResponse">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="getTeamsResponse">
    <wsdl:part element="tns:getTeamsResponse" name="getTeamsResponse">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="getTeamsRequest">
    <wsdl:part element="tns:getTeamsRequest" name="getTeamsRequest">
    </wsdl:part>
  </wsdl:message>
  <wsdl:portType name="FootballPort">
    <wsdl:operation name="enterScores">
      <wsdl:input message="tns:enterScoresRequest" name="enterScoresRequest">
    </wsdl:input>
      <wsdl:output message="tns:enterScoresResponse" name="enterScoresResponse">
    </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="getTeams">
      <wsdl:input message="tns:getTeamsRequest" name="getTeamsRequest">
    </wsdl:input>
      <wsdl:output message="tns:getTeamsResponse" name="getTeamsResponse">
    </wsdl:output>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="FootballPortSoap11" type="tns:FootballPort">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="enterScores">
      <soap:operation soapAction=""/>
      <wsdl:input name="enterScoresRequest">
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="enterScoresResponse">
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="getTeams">
      <soap:operation soapAction=""/>
      <wsdl:input name="getTeamsRequest">
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="getTeamsResponse">
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="FootballPortService">
    <wsdl:port binding="tns:FootballPortSoap11" name="FootballPortSoap11">
      <soap:address location="http://localhost:8080/ws"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>